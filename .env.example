# --- Database (PostgreSQL) ---------------------------------------------
# Any Postgres works: Supabase, Neon, Railway, RDS, or a local instance.
DATABASE_URL="postgresql://user:password@localhost:5432/url_shortener"

# --- App -----------------------------------------------------------------
# Public base URL used to build short links (client + server).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- NextAuth (Auth.js v5) -------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth (optional — Credentials auth works without it).
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Rate limiting (optional) --------------------------------------------
# Without these, anonymous rate limiting falls back to an in-memory limiter
# (fine for local dev, not shared across serverless instances in prod).
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
